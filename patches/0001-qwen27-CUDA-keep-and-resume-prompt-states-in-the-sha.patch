+    /// The pass stands at a keep mark: the lane host copies the stream's state there.
+    fn keptAt(ctx: *anyopaque, at: u32) void {
+        const s: *lanes.Stream = @ptrCast(@alignCast(ctx));
+        if (s.reuse.hook) |k| k.at(k.ptr, s, at);
+    }
+
+    /// The stream's kept state restored into its opened sequence: where its prompt pass starts (0: none, off the
+    /// grid, or a failed copy, which the pass then overwrites from an empty state).
+    fn restoreKept(x: *Cuda, s: *lanes.Stream) usize {
+        const saved = s.reuse.saved orelse return 0;
+        if (!eng.resumable(s.reuse.at, s.prompt().len, x.e.prompt_rows)) {
+            s.reuse_failed = true;
+            return 0;
+        }
+        var target: reuse.Target = .{ .x = x };
+        reuse.restore(&target, s, saved) catch {
+            s.reuse_failed = true;
+            return 0;
+        };
+        s.cached = s.reuse.at;
+        return s.reuse.at;
+    }

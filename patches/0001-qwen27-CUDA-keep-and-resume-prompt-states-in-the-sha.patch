     return .{ start + (end - start) * j / n, start + (end - start) * (j + 1) / n };
 }
 
+/// The end of the chunk starting at `at` on the zero-anchored grid: the next multiple of `step`, never past `len`.
+/// A pass that keeps or resumes prompt states cuts here, so its cuts land where saved states stand.
+pub fn gridEnd(at: usize, len: usize, step: usize) usize {
+    return @min(len, at - at % step + step);
+}
+
+/// A kept state a pass may start from: a grid point inside the prompt.
+pub fn resumable(from: usize, len: usize, step: usize) bool {
+    return from > 0 and from < len and from % step == 0;
+}
+
+/// Prompt positions where a pass stops for the prompt cache, and whom it tells.
+pub const Keep = struct {
+    at: []const u32,
+    ctx: *anyopaque,
+    call: *const fn (*anyopaque, u32) void,
+
+    pub fn reached(k: Keep, at: usize) void {
+        if (at <= std.math.maxInt(u32) and std.mem.indexOfScalar(u32, k.at, @intCast(at)) != null) k.call(k.ctx, @intCast(at));
+    }
+};
+
 /// `streams`: a shared round's windows at most (the scratch's window rows follow); `prompt_rows`: a prompt chunk's rows.

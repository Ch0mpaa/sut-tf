+/// prefill_state with a drafter on the zero-anchored grid, from `from` (0: an empty state; else a restored one).
+/// The context taps the prompt's last `window` rows that this pass computes; `keep` hears each mark it reaches.
+pub fn prefillFrom(e: *Engine, seq: *st.Seq, ctx: *dr.Context, d: *dr.DFlash2, prompt: []const u32, from: usize, keep: ?eng.Keep) !void {
+    if (prompt.len == 0) return error.EmptyPrompt;
+    if (prompt.len >= seq.capacity) return error.PromptTooLong;
+    if (from == 0) try seq.reset(e.ops(), e.w.g) else if (!eng.resumable(from, prompt.len, e.prompt_rows) or seq.pos != from) return error.BadReuse;
+    ctx.len = 0;
+    ctx.end = 0;
+    const tap_from = @max(prompt.len -| dl.window, from);
+    ctx.skip(tap_from);
+    var f = e.forward();
+    f.taps = e.scratch.taps;
+    var s: usize = from;
+    while (s < prompt.len) {
+        const end = eng.gridEnd(s, prompt.len, e.prompt_rows);
+        try f.chunk(prompt[s..end], seq, end == prompt.len);
+        if (end > tap_from) {
+            const skip = tap_from -| s;
+            try d.absorb(ctx, e.scratch.taps + skip * taps_width * bf, end - s - skip);
+        }
+        s = end;
+        if (keep) |k| k.reached(s);
+    }
+}

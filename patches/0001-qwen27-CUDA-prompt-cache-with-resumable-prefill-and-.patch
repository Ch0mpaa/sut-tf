         }
     }
 
+    /// The prompt from `from` on the zero-anchored grid: from an empty state when `from` is 0, else from a restored
+    /// state standing at `from`. `keep` hears each mark the pass reaches between chunks.
+    pub fn prefillFrom(e: *Engine, seq: *st.Seq, prompt: []const u32, from: usize, keep: ?Keep) !void {
+        if (prompt.len == 0) return error.EmptyPrompt;
+        if (prompt.len >= seq.capacity) return error.PromptTooLong;
+        if (from == 0) try seq.reset(e.ops(), e.w.g) else if (!resumable(from, prompt.len, e.prompt_rows) or seq.pos != from) return error.BadReuse;
+        // a grid pass can end on a short piece the even-chunk pass never has: keep the prompt matmuls for it, so a
+        // resumed or kept pass computes the same bits as a cold one (short chunks otherwise take the decode matmuls)
+        const dense = fwd.prompt_dense_rows;
+        fwd.prompt_dense_rows = 0;
+        defer fwd.prompt_dense_rows = dense;
+        var f = e.forward();
+        var s: usize = from;
+        while (s < prompt.len) {
+            const end = gridEnd(s, prompt.len, e.prompt_rows);
+            try f.chunk(prompt[s..end], seq, end == prompt.len);
+            s = end;
+            if (keep) |k| k.reached(s);
+        }
+    }
+

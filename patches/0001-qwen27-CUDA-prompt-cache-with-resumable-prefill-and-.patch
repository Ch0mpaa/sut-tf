index 00000000..4268d580
--- /dev/null
+++ b/zig/src/families/qwen27/cuda/reuse.zig
@@ -0,0 +1,134 @@
+//! Qwen3.8-27B CUDA prompt states for the shared cache: a stream's committed state after `at` prompt tokens.
+//! Added 2026-11-13 for sut-tf.
+//!
+//! A saved state holds each DeltaNet layer's recurrence and conv window, and only the first `at` rows of each
+//! attention layer's keys and values (the caches grow by appending, so a prefix is a whole prefix). The DFlash2
+//! context is not saved: a prompt pass only taps its last window, and a resumed pass taps it again.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const c = @import("shape.zig");
+const st = @import("state.zig");
+const Cuda = @import("lanes.zig").Cuda;
+
+const align_to = 256;
+
+/// Kept states in pinned host memory instead of the card's (TF_QWEN27_HOST_CACHE_GIB, set when the model opens).
+pub var host_tier: bool = false;
+
+/// One kept state: copies packed in one buffer on the card or in pinned host memory, and the position they stand at.
+pub const Copy = struct {
+    dev: ?cuda.DeviceBuffer = null,
+    host: ?cuda.HostBuffer = null,
+    at: usize,
+};
+
+const Where = union(enum) { dev: u64, host: []u8 };
+
+/// The lane backend whose streams the cache copies. The native host keeps one for the loaded model.
+pub const Target = struct {
+    x: *Cuda,
+};
+
+fn of(ptr: *anyopaque) *Target {
+    return @ptrCast(@alignCast(ptr));
+}
+
+/// Bytes the state after `at` prompt tokens takes.
+fn stateBytes(g: c.Geometry, at: usize) usize {
+    var n: usize = 0;
+    for (0..g.layers) |i| {
+        if (c.linear(i)) {
+            n += std.mem.alignForward(usize, g.deltaBytes(), align_to);
+            n += std.mem.alignForward(usize, g.convBytes(), align_to);
+        } else {
+            n += 2 * std.mem.alignForward(usize, at * g.kvRow(), align_to);
+        }
+    }
+    return n;
+}
+
+pub fn bytes(ptr: *anyopaque, at: u32) u64 {
+    return stateBytes(of(ptr).x.e.w.g, at);
+}
+
+const Dir = enum { save, restore };
+
+/// One region between the live state and the kept copy at `off`, in the direction asked.
+fn region(ops: anytype, to: Where, off: usize, live: u64, n: usize, dir: Dir) !void {
+    if (n == 0) return;
+    switch (to) {
+        .dev => |base| if (dir == .save) try ops.copy(base + off, live, n) else try ops.copy(live, base + off, n),
+        .host => |h| if (dir == .save) try ops.download(h[off..][0..n], live) else try ops.upload(live, h[off..][0..n]),
+    }
+}
+
+/// Copy between the stream's live state and the kept copy, layer by layer, in the order stateBytes counts.
+/// A host copy waits for its transfers, so a kept state is whole before anyone can drop it.
+fn move(x: *Cuda, seq: *st.Seq, to: Where, at: usize, dir: Dir) !void {
+    const g = x.e.w.g;
+    const ops = x.e.ops();
+    var off: usize = 0;
+    for (0..g.layers) |i| {
+        if (c.linear(i)) {
+            const pairs = [_][2]u64{ .{ seq.rec[i], g.deltaBytes() }, .{ seq.conv[i], g.convBytes() } };
+            for (pairs) |p| {
+                try region(ops, to, off, p[0], p[1], dir);
+                off += std.mem.alignForward(usize, p[1], align_to);
+            }
+        } else {
+            const n = at * g.kvRow();
+            for ([_]u64{ seq.keys[i], seq.values[i] }) |live| {
+                try region(ops, to, off, live, n, dir);
+                off += std.mem.alignForward(usize, n, align_to);
+            }
+        }
+    }
+    if (to == .host) try ops.s.synchronize();
+}
+
+/// Copy the stream's state after `at` prompt tokens into new device storage. The pass stands there.
+pub fn save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!*anyopaque {
+    const t = of(ptr);
+    const s: *lanes.Stream = @ptrCast(@alignCast(owner orelse return error.NoQwenStream));
+    const seq = t.x.seqs.get(s) orelse return error.UnknownQwenStream;
+    if (seq.pos != at) return error.NotAtMark;
+    const copy = try t.x.gpa.create(Copy);
+    errdefer t.x.gpa.destroy(copy);
+    copy.* = .{ .at = at };
+    const len = stateBytes(t.x.e.w.g, at);
+    if (host_tier) {
+        copy.host = try cuda.HostBuffer.alloc(t.x.e.ctx.d, len);
+        errdefer copy.host.?.free();
+        try move(t.x, seq, .{ .host = copy.host.?.bytes }, at, .save);
+    } else {
+        copy.dev = try cuda.DeviceBuffer.alloc(t.x.e.ctx.d, len);
+        errdefer copy.dev.?.free();
+        try move(t.x, seq, .{ .dev = copy.dev.?.ptr }, at, .save);
+    }
+    return copy;
+}
+
+fn whereOf(copy: *Copy) Where {
+    return if (copy.host) |h| .{ .host = h.bytes } else .{ .dev = copy.dev.?.ptr };
+}
+
+/// Make the stream's opened state `saved`'s: the next prompt chunk starts at its position.
+pub fn restore(ptr: *anyopaque, owner: ?*anyopaque, saved: *anyopaque) anyerror!void {
+    const t = of(ptr);
+    const copy: *Copy = @ptrCast(@alignCast(saved));
+    const s: *lanes.Stream = @ptrCast(@alignCast(owner orelse return error.NoQwenStream));
+    const seq = t.x.seqs.get(s) orelse return error.UnknownQwenStream;
+    if (copy.at >= seq.capacity) return error.PromptTooLong;
+    try move(t.x, seq, whereOf(copy), copy.at, .restore);
+    seq.pos = copy.at;
+}
+
+pub fn drop(ptr: *anyopaque, saved: *anyopaque) void {
+    const t = of(ptr);
+    const copy: *Copy = @ptrCast(@alignCast(saved));
+    if (copy.dev) |*d| d.free();
+    if (copy.host) |*h| h.free();
+    t.x.gpa.destroy(copy);
+}
